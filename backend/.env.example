MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=chess_eval
STOCKFISH_PATH=/usr/local/bin/stockfish
# Search depth per position (UCI `go depth N`)
STOCKFISH_DEPTH=64
# 0 = depth-only (go depth N). >0 adds movetime cap per go.
STOCKFISH_MOVETIME=0
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
# Lines to request per position for accurate centipawn loss
STOCKFISH_MULTIPV=3
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_PREFIX=/api/v1
DEBUG=false
REDIS_URL=redis://localhost:6379/0
# Only cache positions evaluated at this depth or higher
POSITION_CACHE_MIN_DEPTH=12
# Engine pool size for parallel analyses
MAX_CONCURRENT_ANALYSES=2
