# App 
DEBUG=false
LOG_JSON=false
# Reserved for structlog JSON pipeline (see config); stdlib JSON uses LOG_JSON.
STRUCTLOG_JSON=false
API_PREFIX=/api/v1

# CORS (JSON array) 
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:4173"]

# MongoDB 
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=chess_eval

# Stockfish 
STOCKFISH_PATH=/usr/local/bin/stockfish
# Search depth per position (UCI `go depth N`, capped by MAX_ANALYSIS_DEPTH)
STOCKFISH_DEPTH=64
# 0 = depth-only. >0 adds movetime to each `go` (ms).
STOCKFISH_MOVETIME=0
# Extra wall-clock ceiling per `go` in ms; 0 disables.
STOCKFISH_MAX_MOVETIME_MS=10000
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
# MultiPV for FEN / general engine lines
STOCKFISH_MULTIPV=3
# MultiPV lines when resolving played move in PGN path
STOCKFISH_PGN_MULTIPV_LINES=5

# Classifier (centipawn loss from player POV) 
CLASSIFIER_CP_EXCELLENT=10
CLASSIFIER_CP_GOOD=25
CLASSIFIER_CP_INACCURACY=50
CLASSIFIER_CP_MISTAKE=150
CLASSIFIER_MISS_MIN_ADVANTAGE_PAWNS=2.0
CLASSIFIER_BRILLIANT_SWING_PAWNS=1.0
CLASSIFIER_BRILLIANT_SACRIFICE_CP=80

# Stale jobs 
STALE_PROCESSING_MINUTES=10

# Redis 
REDIS_URL=redis://localhost:6379/0

# Analysis / cache 
MAX_ANALYSIS_DEPTH=245
CACHE_TTL_SECONDS=86400
MAX_PGN_SIZE_KB=512
POSITION_CACHE_MIN_DEPTH=12
MAX_CONCURRENT_ANALYSES=2

# Opening book (optional .bin; empty = off) 
OPENING_POLYGLOT_PATH=
OPENING_POLYGLOT_MAX_PLY=16
OPENING_ECO_MAX_BOOK_PLY=18
# After `python scripts/normalize_cache_white_pov.py`, you may set CACHE_STRICT_WHITE_POV=true.
CACHE_STRICT_WHITE_POV=false

# Two-pass depth (cheap eval then full depth) 
ANALYSIS_TWO_PASS_ENABLED=true
ANALYSIS_CHEAP_PASS_DEPTH=12
# Lichess-style accuracy child FEN probes: UCI depth (0 = use ANALYSIS_CHEAP_PASS_DEPTH)
ACCURACY_CHILD_DEPTH=0
# Sliding-window volatility: max half-window (game length also scales window).
ACCURACY_VOLATILITY_HALF_WINDOW_MAX=6
# lichess | downweight — downweight reduces volatility weights when |played child cp| >= threshold.
ACCURACY_DECISIVE_CP_MODE=lichess
ACCURACY_DECISIVE_CP_THRESHOLD_CP=1000

# Chess.com public API profile cache (Mongo TTL) 
CHESSCOM_PROFILE_CACHE_TTL_SECONDS=3600
